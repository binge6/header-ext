{
  "name": "header-ext",
  "description": "A browser extension to modify HTTP request/response headers, append cookies, and redirect URLs by rules.",
  "private": true,
  "version": "0.0.11",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit:init": "wxt submit init",
    "submit:dry": "wxt submit --dry-run --chrome-zip .output/header-ext-$npm_package_version-chrome.zip --firefox-zip .output/header-ext-$npm_package_version-firefox.zip --firefox-sources-zip .output/header-ext-$npm_package_version-sources.zip --edge-zip .output/header-ext-$npm_package_version-chrome.zip",
    "submit": "wxt submit --chrome-zip .output/header-ext-$npm_package_version-chrome.zip --firefox-zip .output/header-ext-$npm_package_version-firefox.zip --firefox-sources-zip .output/header-ext-$npm_package_version-sources.zip --edge-zip .output/header-ext-$npm_package_version-chrome.zip",
    "compile": "tsc --noEmit",
    "lint": "oxlint entrypoints src wxt.config.ts vitest.config.ts --deny-warnings",
    "lint:fix": "oxlint entrypoints src wxt.config.ts vitest.config.ts --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm compile",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "nanoid": "^6.0.1",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  }
}
