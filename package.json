{
  "name": "header-ext",
  "description": "A browser extension to modify HTTP request/response headers, append cookies, and redirect URLs by rules.",
  "private": true,
  "version": "0.0.7",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.101.0",
    "@douyinfe/semi-ui": "^2.101.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@douyinfe/semi-vite-plugin": "^2.101.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
